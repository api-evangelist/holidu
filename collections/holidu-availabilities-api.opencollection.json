{
  "opencollection": "1.0.0",
  "info": {
    "name": "Affiliate Apartment Availabilities API",
    "version": "1.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Availabilities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get information about the availability of given offers",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://external-api.holidu.com/availabilities",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve real-time prices and availability for specified properties on given dates."
        }
      ]
    }
  ],
  "bundled": true
}