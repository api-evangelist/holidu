          },
          "http": {
            "method": "POST",
            "url": "https://external-api.holidu.com/changed",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns property IDs with data potentially updated within the specified time range. The inventory is continuously refreshed, with more frequent updates for recent days."
        }
      ]
    }
  ],
  "bundled": true
